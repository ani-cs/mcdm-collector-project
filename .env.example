# Supabase project credentials
# Find these in your Supabase dashboard:
#   Project Settings -> Data API -> API URL
#   Project Settings -> API keys -> Secret key

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=

# Comma-separated list of frontend origins allowed to call this API (no
# trailing slashes — browsers never send one in the Origin header).
CORS_ALLOWED_ORIGINS=http://localhost:5173